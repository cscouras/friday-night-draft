{
  "name": "Astro Fantasy Tracker",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "node",

  "runArgs": [
    "--security-opt=seccomp=unconfined"
  ],

  "forwardPorts": [4321],
  "portsAttributes": {
    "4321": {
      "label": "Astro Dev Server",
      "onAutoForward": "notify"
    }
  },

  "containerEnv": {
    "XDG_CONFIG_HOME": "/workspaces/friday-night-draft/.opencode/config",
    "XDG_DATA_HOME": "/workspaces/friday-night-draft/.opencode/data"
  },

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "astro-build.astro-vscode",
        "dbaeumer.vscode-eslint",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}