---
import Layout from '../../../../layouts/Layout.astro';
import { getWeeklyAudit } from '../../../../lib/tracker';
import { seasons, type Season, type WeekData } from '../../../../data/seasons';

export function getStaticPaths() {
	return seasons.flatMap((s) =>
		s.weeks.map((w) => ({
			params: { season: s.id, week: w.week.toString() },
			props: { season: s, weekNumber: w.week, weekData: w },
		}))
	);
}

const { season, weekNumber, weekData } = Astro.props as {
	season: Season;
	weekNumber: number;
	weekData: WeekData;
};

const { median, rows } = getWeeklyAudit(weekData.matchups);
const sorted = rows.sort((a, b) => b.score - a.score);

const resultClass = (r) => (r === 'W' ? 'w' : r === 'L' ? 'l' : 't');

const tieBreaker = () => sorted.some((r) => r.h2h === 'T' || r.med === 'T');
---

<Layout title={`Week ${weekNumber} Results | ${season.label} | Friday Night Draft`}>
	<div class="container">
		<nav>
			<a href={`/seasons/${season.id}`}>← Back to Standings</a>
			<a href={`/seasons/${season.id}/progress`}>Running Standings →</a>
		</nav>
		<header>
			<h1>Week {weekNumber} Results</h1>
			<p class="subtitle">
				League Median Cutoff: <strong>{median.toFixed(2)}</strong> · Verify
				weekly scores and how each W and L was earned
			</p>
		</header>
		<div class="table-wrap">
			<table>
				<thead>
					<tr>
						<th>Team</th>
						<th class="numeric">Score</th>
						<th>Opponent</th>
						<th class="numeric">H2H</th>
						<th class="numeric">vs Median</th>
						<th class="numeric">Week Rec</th>
					</tr>
				</thead>
				<tbody>
					{
						sorted.map((row) => (
							<tr>
								<td><strong>{row.name}</strong></td>
								<td class="numeric">{row.score.toFixed(2)}</td>
								<td class="opp">
									{row.opponent} ({row.oppScore.toFixed(2)})
								</td>
								<td class="numeric">
									<span class={`result ${resultClass(row.h2h)}`}>
										{row.h2h}
									</span>
								</td>
								<td class="numeric">
									<span class={`result ${resultClass(row.med)}`}>
										{row.med}
									</span>
								</td>
								<td class="numeric">
									{row.wins}-{row.losses}
									{row.ties > 0 ? '-' + row.ties : ''}
								</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
		{
			tieBreaker() ? (
				<p class="notes">
					Ties (T) count as half a win/loss and are included in the standings.
				</p>
			) : null
		}
	</div>

	<style>
		nav {
			display: flex;
			gap: 1rem;
			margin-bottom: 1.5rem;
		}
		nav a {
			color: var(--link);
			text-decoration: none;
		}
		.opp {
			color: var(--text-muted);
		}
		.result {
			font-weight: bold;
		}
		.result.w {
			color: var(--win);
		}
		.result.l {
			color: var(--lose);
		}
		.result.t {
			color: var(--tie);
		}
		.notes {
			color: var(--text-muted);
			margin-top: 1rem;
			font-size: 0.85rem;
		}
	</style>
</Layout>