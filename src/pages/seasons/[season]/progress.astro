---
import Layout from '../../../layouts/Layout.astro';
import { LeagueTracker, type TeamStanding } from '../../../lib/tracker';
import { seasons, type Season } from '../../../data/seasons';

export function getStaticPaths() {
	return seasons.map((s) => ({
		params: { season: s.id },
		props: { season: s },
	}));
}

const { season } = Astro.props as { season: Season };

interface Snapshot {
	week: number;
	standings: TeamStanding[];
}

const snapshots: Snapshot[] = [];
const tracker = new LeagueTracker();
for (const w of season.weeks) {
	tracker.processWeek(w.matchups);
	snapshots.push({ week: w.week, standings: tracker.getStandings() });
}

const finalStandings = snapshots[snapshots.length - 1]!.standings;

const teamOrder = finalStandings.map((t) => t.teamId);
const rows = teamOrder.map((id) => {
	const name = finalStandings.find((t) => t.teamId === id)!.name;
	const cells = snapshots.map(
		(snap) => snap.standings.find((t) => t.teamId === id) ?? null
	);
	const finalRow = finalStandings.find((t) => t.teamId === id)!;
	return { id, name, cells, finalRow };
});

const record = (s: TeamStanding | null) => {
	if (!s) return '–';
	return s.t > 0 ? `${s.w}-${s.l}-${s.t}` : `${s.w}-${s.l}`;
};
---

<Layout title={`Running Standings | ${season.label} | Friday Night Draft`}>
	<div class="container wide">
		<nav>
			<a href={`/seasons/${season.id}`}>← Back to Standings</a>
			<a href={`/seasons/${season.id}/weeks/1`}>Week Results →</a>
		</nav>
		<header>
			<h1>Running Standings</h1>
			<p class="subtitle">
				Cumulative W-L-T after each week. Follow each team column across to
				verify it adds up to today's standings.
			</p>
		</header>
		<div class="table-wrap">
			<table>
				<thead>
					<tr>
						<th class="name">Team</th>
						{snapshots.map((snap) => <th>Wk {snap.week}</th>)}
						<th>Now</th>
						<th>Win %</th>
						<th>PF</th>
					</tr>
				</thead>
				<tbody>
					{
						rows.map((row) => (
							<tr>
								<td class="name"><strong>{row.name}</strong></td>
								{row.cells.map((cell) => <td>{record(cell)}</td>)}
								<td class="final">{record(row.finalRow)}</td>
								<td>{(row.finalRow.winPct * 100).toFixed(1)}%</td>
								<td>{row.finalRow.pf.toFixed(2)}</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</div>

	<style>
		.container.wide {
			max-width: 1100px;
		}
		nav {
			display: flex;
			gap: 1rem;
			margin-bottom: 1.5rem;
		}
		nav a {
			color: var(--link);
			text-decoration: none;
		}
		table {
			font-size: 0.9rem;
		}
		th,
		td {
			text-align: center;
			white-space: nowrap;
			padding: 0.6rem 0.75rem;
		}
		th.name,
		td.name {
			text-align: left;
		}
		td.final {
			color: var(--tie);
			font-weight: bold;
		}
	</style>
</Layout>