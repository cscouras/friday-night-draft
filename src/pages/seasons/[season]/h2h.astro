---
import Layout from '../../../layouts/Layout.astro';
import { LeagueTracker, formatRecord } from '../../../lib/tracker';
import { seasons, type Season } from '../../../data/seasons';

export function getStaticPaths() {
	return seasons.map((s) => ({
		params: { season: s.id },
		props: { season: s },
	}));
}

const { season } = Astro.props as { season: Season };

const leagueTracker = new LeagueTracker();
const h2hTracker = new LeagueTracker({ mode: 'h2h' });

for (const week of season.weeks) {
	leagueTracker.processWeek(week.matchups);
	h2hTracker.processWeek(week.matchups);
}

const leagueStandings = leagueTracker.getStandings();
const h2hStandings = h2hTracker.getStandings();

const leagueRankById = new Map(leagueStandings.map((t, i) => [t.teamId, i]));

const rows = h2hStandings.map((team, h2hRank) => {
	const leagueRank = leagueRankById.get(team.teamId) ?? h2hRank;
	const league = leagueRankById.has(team.teamId)
		? leagueStandings[leagueRank]
		: null;
	const movement = h2hRank - leagueRank;
	return { team, h2hRank, league, leagueRank, movement };
});

const totalWeeks = season.weeks.length;

interface ComparisonRow {
	h2hRank: number;
	leagueRank: number;
}

const ordinal = (n: number) => {
	const ones = n % 10;
	const tens = Math.floor(n / 10) % 10;
	if (tens === 1) return `${n}th`;
	if (ones === 1) return `${n}st`;
	if (ones === 2) return `${n}nd`;
	if (ones === 3) return `${n}rd`;
	return `${n}th`;
};

const movers = rows
	.filter((r) => r.movement !== 0)
	.sort((a, b) => b.movement - a.movement);

const position = (r: ComparisonRow) =>
	`${ordinal(r.h2hRank + 1)} → ${ordinal(r.leagueRank + 1)}`;

const summary = () => {
	if (movers.length === 0) {
		return `With ${totalWeeks} completed ${totalWeeks === 1 ? 'week' : 'weeks'}, adding the league median matchup wouldn't have changed any team's final placement.`;
	}
	const riser = movers[0];
	const faller = movers[movers.length - 1];
	const riserClause = `${riser.team.name} would have climbed ${riser.movement} ${riser.movement === 1 ? 'place' : 'places'} (${position(riser)})`;
	const fallerClause = `${faller.team.name} would have slipped ${Math.abs(faller.movement)} ${Math.abs(faller.movement) === 1 ? 'place' : 'places'} (${position(faller)})`;
	return `If league median scoring had been used, ${movers.length} of ${rows.length} teams would have finished in a different spot. ${riserClause}; ${fallerClause}.`;
};
---

<Layout
	title={`Standings If We'd Had Median Scoring | ${season.label} | Friday Night Draft`}
>
	<div class="container">
		<nav>
			<a href={`/seasons/${season.id}`}>← Back to Standings</a>
			<a href={`/seasons/${season.id}/progress`}>Running Standings →</a>
		</nav>
		<header>
			<h1>Standings If We'd Had Median Scoring</h1>
			<p class="subtitle">
				Our league is head-to-head only. These standings show how final
				placements would have changed if we'd also counted the matchup
				against each week's league median.
			</p>
		</header>
		<p class="summary">{summary()}</p>
		<div class="table-wrap">
			<table>
				<thead>
					<tr>
						<th class="rank-col">#</th>
						<th>Team</th>
						<th class="numeric">H2H Rec</th>
						<th class="numeric">H2H Win %</th>
						<th class="numeric">Med Rec</th>
						<th class="numeric">W/ Median Rec</th>
						<th class="numeric">W/ Median Win %</th>
						<th class="numeric">PF</th>
						<th class="numeric">Δ Rank</th>
					</tr>
				</thead>
				<tbody>
					{
						rows.map((row) => (
							<tr>
								<td class="rank-col">{row.h2hRank + 1}</td>
								<td><strong>{row.team.name}</strong></td>
								<td class="numeric">
									{formatRecord(row.team.w, row.team.l, row.team.t)}
								</td>
								<td class="numeric">
									{(row.team.winPct * 100).toFixed(1)}%
								</td>
								<td class="numeric">
									{row.league?.median
										? formatRecord(
												row.league.median.w,
												row.league.median.l,
												row.league.median.t,
											)
										: '–'}
								</td>
								<td class="numeric">
									{row.league
										? formatRecord(row.league.w, row.league.l, row.league.t)
										: '–'}
								</td>
								<td class="numeric">
									{row.league ? (row.league.winPct * 100).toFixed(1) : '–'}%
								</td>
								<td class="numeric">{row.team.pf.toFixed(2)}</td>
								<td class="numeric">
									<span
										class={`delta ${row.movement > 0 ? 'up' : row.movement < 0 ? 'down' : 'same'}`}
									>
										{row.movement > 0
											? `↑${row.movement}`
											: row.movement < 0
												? `↓${Math.abs(row.movement)}`
												: '—'}
									</span>
								</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
		<p class="notes">
			Δ Rank shows how the final placement would have changed if league median
			scoring had been counted (↑ climbed, ↓ slipped).
		</p>
	</div>

	<style>
		nav {
			display: flex;
			gap: 1rem;
			margin-bottom: 1.5rem;
		}
		nav a {
			color: var(--link);
			text-decoration: none;
		}
		.rank-col {
			width: 70px;
		}
		.summary {
			margin: 1rem 0 1.25rem;
			padding: 0.9rem 1.1rem;
			background-color: var(--surface);
			border-left: 3px solid var(--header);
			border-radius: 6px;
			line-height: 1.5;
		}
		.delta {
			font-weight: bold;
		}
		.delta.up {
			color: var(--win);
		}
		.delta.down {
			color: var(--lose);
		}
		.delta.same {
			color: var(--text-muted);
		}
		.notes {
			color: var(--text-muted);
			margin-top: 1rem;
			font-size: 0.85rem;
		}
	</style>
</Layout>