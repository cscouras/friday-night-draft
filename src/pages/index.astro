---
import Layout from '../layouts/Layout.astro';
import { seasons } from '../data/seasons';
import { getWhatIf } from '../lib/whatif';

const whatIf = new Map(seasons.map((s) => [s.id, getWhatIf(s)]));
---

<Layout title="Friday Night Draft | Median Scoring">
	<div class="container">
		<header>
			<h1>Friday Night Draft</h1>
			<p class="subtitle">League Median Scoring · pick a season</p>
		</header>
		<div class="seasons">
			{
				seasons.map((s) => {
					const { movers, rows } = whatIf.get(s.id)!;
					return (
						<div class="card">
							<a class="card-main" href={`/seasons/${s.id}`}>
								<strong>{s.label}</strong>
								<span>{s.weeks.length} Completed {s.weeks.length === 1 ? 'Week' : 'Weeks'}</span>
							</a>
							{
								s.complete && (
									<a class="card-whatif" href={`/seasons/${s.id}/h2h`}>
										Median What-If:
										{movers.length === 0
											? ' Standings unchanged'
											: ` ${movers.length} of ${rows.length} teams would've finished differently`}
										{' '}→
									</a>
								)
							}
						</div>
					);
				})
			}
		</div>
	</div>

	<style>
		.seasons {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
			gap: 0.75rem;
		}
		.card {
			display: flex;
			flex-direction: column;
			gap: 0.25rem;
			padding: 1rem 1.25rem;
			background-color: var(--surface);
			color: var(--text);
			border-radius: 8px;
		}
		.card:hover {
			background-color: var(--row-hover);
		}
		.card-main {
			display: flex;
			flex-direction: column;
			gap: 0.4rem;
			color: var(--text);
			text-decoration: none;
		}
		.card-main strong {
			display: block;
		}
		.card-main span {
			color: var(--text-muted);
			font-size: 0.85rem;
		}
		.card-whatif {
			margin-top: 0.9rem;
			color: var(--link);
			font-size: 0.85rem;
			text-decoration: none;
		}
	</style>
</Layout>