---
import Layout from '../layouts/Layout.astro';
import { seasons } from '../data/seasons';
---

<Layout title="Friday Night Draft | Median Scoring">
	<div class="container">
		<header>
			<h1>Friday Night Draft</h1>
			<p class="subtitle">League Median Scoring · pick a season</p>
		</header>
		<div class="seasons">
			{
				seasons.map((s) => (
					<a class="card" href={`/seasons/${s.id}`}>
						<strong>{s.label}</strong>
						<span>{s.weeks.length} Completed {s.weeks.length === 1 ? 'Week' : 'Weeks'}</span>
					</a>
				))
			}
		</div>
	</div>

	<style>
		.seasons {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
			gap: 0.75rem;
		}
		.card {
			display: flex;
			flex-direction: column;
			gap: 0.25rem;
			padding: 1rem 1.25rem;
			background-color: var(--surface);
			color: var(--text);
			border-radius: 8px;
			text-decoration: none;
		}
		.card:hover {
			background-color: var(--row-hover);
		}
		.card span {
			color: var(--text-muted);
			font-size: 0.85rem;
		}
	</style>
</Layout>